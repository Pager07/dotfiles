# Template for ~/.secrets — copy this to ~/.secrets and fill in real values.
# ~/.secrets is sourced by zshrc and is NEVER committed (gitignored).
# Real values: from the "keys" block sent to yourself (Slack-to-self).

# Used by `git ppr` (pull_pull_request.py) to auth against the GitHub API.
# Format is  username:token  (a classic ghp_ PAT).
export GITHUB_USERNAME_TOKEN='<github-username>:<ghp_token>'

# OpenAI API key (used by various scripts/tools).
export OPENAI_API_KEY='<sk-proj-...>'
