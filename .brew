# Homebrew packages for this machine setup.
#
# Install the must-have formulae in one go:
#   grep -v '^#' .brew | grep . | xargs brew install
#
# Casks / tapped packages are listed under their own headers below
# (they need slightly different commands — see the comments).

# ============================================================
# MUST HAVE
# Required by the nvim / tmux / aerospace configs in this repo.
# ============================================================
neovim
tmux
node
tree-sitter
fd
fzf
ripgrep
lazygit

# ============================================================
# PROGRAMMING / DEV TOOLING
# Language runtimes & project tooling.
# ============================================================
uv          # Python package/venv manager + interpreter installer
            #   uv python install 3.x   -> install an interpreter
            #   uv venv --python 3.x    -> create a pinned venv
            # Standalone installer (no Homebrew):
            #   curl -LsSf https://astral.sh/uv/install.sh | sh

# ============================================================
# TUTORCRUNCHER (TC2) DEV
# Backend services for running TutorCruncher2 locally.
# Start as services:  brew services start postgresql@16 redis
# ============================================================
postgresql@16   # database (keg-only / versioned)
redis           # job queue (RQ), caching, email outbox
yarn            # frontend assets (needs node)
# wkhtmltopdf   # PDF generation — REMOVED from Homebrew (upstream archived).
#               # Install the .pkg from github.com/wkhtmltopdf/packaging/releases
#               # only when you need PDF features.

# ---- Casks (GUI apps) ----
# aerospace — tiling window manager. Needs a tap first:
#   brew tap nikitabobko/tap
#   brew install --cask aerospace

# ============================================================
# OPTIONAL
# Heavy or situational. Install by hand only if you need them.
# ============================================================
# ffmpeg       audio/video processing; pulls in ~80 codec libraries
# claude-code  already installed via the native installer (~/.local/bin)
